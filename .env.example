# Chemin du fichier SQLite (relatif à la racine du projet)
DB_PATH="database/abricot.sqlite"

# Secret utilisé pour signer les tokens JWT : remplacez-le par une valeur longue et aléatoire (32 caractères minimum)
JWT_SECRET="changez-moi-par-une-valeur-longue-et-aleatoire"
# Durée de validité des tokens, en secondes (7 jours)
JWT_TTL=604800

APP_ENV=development

# Origines autorisées à appeler l'API (front-end React), séparées par des virgules
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
